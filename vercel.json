{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/session",
      "destination": "/api/session.js"
    },
    {
      "source": "/api/ask",
      "destination": "/api/ask.js"
    },
    {
      "source": "/api/logout",
      "destination": "/api/logout.js"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
